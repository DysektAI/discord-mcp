# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_default_guild_id_here

# Optional: comma-separated gateway intents.
# Defaults to non-privileged intents when omitted.
# DISCORD_INTENTS=Guilds,GuildMessages,DirectMessages,GuildVoiceStates,GuildModeration,GuildMessageReactions,DirectMessageReactions
# Add privileged intents only if enabled in Discord Developer Portal:
# GuildMembers,MessageContent,GuildPresences

# OAuth bot install + callback flow (required for automatic admin install URL in HTTP mode)
# DISCORD_CLIENT_ID=your_discord_application_client_id
# DISCORD_CLIENT_SECRET=your_discord_application_client_secret
# DISCORD_OAUTH_REDIRECT_URI=http://localhost:1455/oauth/discord/callback
# DISCORD_OAUTH_DEFAULT_GUILD_ID=optional_default_guild_id
# DISCORD_OAUTH_STATE_TTL_SECONDS=600
# DISCORD_OAUTH_STORE_PATH=./data/oauth-sessions.json

# Optional: HTTP mode for MCP server
# MCP_HTTP_PORT=1455

# Optional: MCP/ChatGPT remote authentication.
# MCP_AUTH_MODE=off|mixed|required
# - off: no MCP transport auth
# - mixed: initialize/tools/list are open, tools/call requires auth
# - required: all MCP HTTP/SSE traffic requires auth
# Defaults to mixed when MCP_OAUTH_ENABLED=true or MCP_HTTP_AUTH_TOKEN is set.
#
# Simple bearer token for private remote testing:
# MCP_HTTP_AUTH_TOKEN=change_this_to_a_long_random_value
#
# OAuth/JWKS bearer validation for ChatGPT Apps or MCP clients:
# MCP_OAUTH_ENABLED=true
# MCP_OAUTH_ISSUER=https://issuer.example.com
# MCP_OAUTH_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# MCP_OAUTH_RESOURCE=https://mcp.yourdomain.com
# MCP_OAUTH_REQUIRED_SCOPES=mcp:all
# MCP_OAUTH_SCOPES_SUPPORTED=mcp:all
# MCP_OAUTH_AUTHORIZATION_SERVERS=https://issuer.example.com
# MCP_OAUTH_ALLOWED_USER_IDS=uuid1,uuid2
# MCP_OAUTH_ALLOWED_EMAILS=you@example.com
# MCP_OAUTH_CONSENT_PATH=/oauth/consent
#
# Supabase Auth convenience values for the optional consent page/JWKS defaults:
# SUPABASE_PROJECT_REF=your_project_ref
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: server logging
# LOG_LEVEL=INFO
# LOG_STYLE=pretty # when unset: auto selects pretty for interactive terminal/dev runs, json for non-interactive output
# LOG_COLOR=true
# ENABLE_LOGGING=true

# Optional: OpenTelemetry
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=discord-mcp
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer token
# OTEL_PROMETHEUS_PORT=9464
# OTEL_PROMETHEUS_ENDPOINT=/metrics
