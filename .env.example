# Environment Variables (DO NOT COMMIT TOKENS!)
# Copy this file to .env and fill in your actual values

# Discord Bot Token (required)
DISCORD_TOKEN=your_discord_bot_token_here

# Default Discord Server ID (optional)
# When provided, guildId parameter becomes optional for tools
DISCORD_GUILD_ID=your_default_guild_id_here

# Logging Configuration
ENABLE_LOGGING=true
LOG_LEVEL=INFO

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=1000
TIMEOUT=30000

# Rate Limit Protection
RATE_LIMIT_PROTECTION=true

# HTTP Server Security (optional, only used when MCP_HTTP_PORT or PORT is set)
# Set a token to require Authorization header: "Bearer <token>"
# MCP_HTTP_AUTH_TOKEN=change_this_to_a_long_random_value
# If HTTP transport is enabled, you must configure either MCP_HTTP_AUTH_TOKEN
# or MCP_OAUTH_ENABLED=true.
# Limit JSON body size in bytes (default 5000000)
# MCP_HTTP_MAX_BODY_BYTES=5000000
# Log HTTP requests (default true when ENABLE_LOGGING=true)
# MCP_HTTP_LOG_REQUESTS=true

# OAuth (required for ChatGPT Apps auth; set MCP_OAUTH_ENABLED=true)
# MCP_OAUTH_ENABLED=true
# Supabase project ref (used to derive issuer/JWKS): https://<ref>.supabase.co
# SUPABASE_PROJECT_REF=your_project_ref
# Supabase URL (used by consent page, defaults from project ref)
# SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon key (used by consent page, safe to expose)
# SUPABASE_ANON_KEY=your_supabase_anon_key
# Or explicitly set issuer/JWKS:
# MCP_OAUTH_ISSUER=https://<ref>.supabase.co/auth/v1
# MCP_OAUTH_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# Public URL of this MCP server (required when OAuth and HTTP transport are enabled)
# MCP_OAUTH_RESOURCE=https://mcp.yourdomain.com
# Consent page also requires SUPABASE_ANON_KEY so the browser can complete
# the authorization flow.
# Optional: required scopes (comma-separated)
# MCP_OAUTH_REQUIRED_SCOPES=mcp:all
# Optional: supported scopes to advertise
# MCP_OAUTH_SCOPES_SUPPORTED=mcp:all
# Optional: consent path (must match Supabase OAuth Server Authorization Path)
# MCP_OAUTH_CONSENT_PATH=/oauth/consent
# Optional: restrict OAuth to specific users (comma-separated)
# MCP_OAUTH_ALLOWED_USER_IDS=uuid1,uuid2
# MCP_OAUTH_ALLOWED_EMAILS=you@example.com

# Action Permissions (comma-separated, leave empty for all actions)
# ALLOWED_ACTIONS=get_server_info,send_message,read_messages
# DENIED_ACTIONS=delete_channel,ban_member
