# Environment Variables (DO NOT COMMIT TOKENS!)
# Copy this file to .env and fill in your actual values

# Discord Bot Token (required)
DISCORD_TOKEN=your_discord_bot_token_here

# Default Discord Server ID (optional)
# When provided, guildId parameter becomes optional for tools
DISCORD_GUILD_ID=your_default_guild_id_here

# Logging Configuration
ENABLE_LOGGING=true
LOG_LEVEL=INFO

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=1000
TIMEOUT=30000

# Rate Limit Protection
RATE_LIMIT_PROTECTION=true

# HTTP Server Security (optional, only used when MCP_HTTP_PORT or PORT is set)
# Set a token to require Authorization header: "Bearer <token>"
# MCP_HTTP_AUTH_TOKEN=change_this_to_a_long_random_value
# Limit JSON body size in bytes (default 5000000)
# MCP_HTTP_MAX_BODY_BYTES=5000000

# Action Permissions (comma-separated, leave empty for all actions)
# ALLOWED_ACTIONS=get_server_info,send_message,read_messages
# DENIED_ACTIONS=delete_channel,ban_member
